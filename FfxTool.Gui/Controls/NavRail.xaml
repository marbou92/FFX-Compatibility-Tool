<UserControl x:Class="FfxTool.Gui.NavRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui"
             Width="88">
    <!-- M3 Expressive nav rail: brand mark, expressive FAB, icon-over-label
         items with a spring-animated active-indicator pill (built in code).
         The 50px pill backs the 50px icon wrap one-to-one — constants are
         mirrored in NavRail.cs (IconWrap/PillSize/ItemHeight). -->
    <Border Background="{DynamicResource B.SCLow}" BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Background="{DynamicResource B.PrimaryContainer}">
                    <controls:IconGlyph IconName="Logo" Width="28" Height="28"
                                        Foreground="{DynamicResource B.Primary}"/>
                </Border>
                <!-- M3E FAB: rounded-square silhouette + soft elevation, so it
                     never reads as a second selected item beside the round
                     active pill. Hover/pressed are state layers, not opacity
                     fades of the whole button. -->
                <Button x:Name="Fab" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Background="{DynamicResource B.PrimaryContainer}" Focusable="False"
                        Cursor="Hand" ToolTip="Open a .ffx file">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="12" Direction="270" Opacity="0.3"/>
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="StateLayer" Background="{DynamicResource B.OnPrimaryContainer}"
                                        CornerRadius="16" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="StateLayer" Property="Opacity" Value="0.1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="StateLayer" Property="Opacity" Value="0.16"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <controls:IconGlyph x:Name="FabIcon" IconName="Add" Width="26" Height="26"
                                        Foreground="{DynamicResource B.OnPrimaryContainer}"
                                        RenderTransformOrigin="0.5,0.5">
                        <controls:IconGlyph.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </controls:IconGlyph.RenderTransform>
                    </controls:IconGlyph>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
                <Canvas x:Name="PillLayer" IsHitTestVisible="False">
                    <Border x:Name="Pill" Width="50" Height="50" CornerRadius="25"
                            Background="{DynamicResource B.PrimaryContainer}" Canvas.Left="19">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PillMove" Y="3"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
                <StackPanel x:Name="Items"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
