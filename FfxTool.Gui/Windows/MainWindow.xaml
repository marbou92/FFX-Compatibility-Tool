<Window x:Class="FfxTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FfxTool.Gui"
        Title="FFX Compatibility Tool" Width="1180" Height="740"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Outline}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Custom window overlay (fully replaces the native frame).
         WindowStyle stays SingleBorderWindow ON PURPOSE: DWM only plays the
         Windows 7 minimize/maximize animations (and grants Aero Snap + live
         taskbar previews) to windows that carry WS_CAPTION, and the stock
         WindowChrome worker never re-adds it once WindowStyle="None"
         strips it — that is exactly why minimizing used to snap shut with
         no animation. WindowChrome still keeps the client area covering the
         whole window via WM_NCCALCSIZE, so the native frame is never drawn.
         Edge anatomy (v2): the HWND is cut to the rounded silhouette with
         SetWindowRgn (MainWindow.ApplyWindowRegion) — the OS simply never
         paints the corner pixels, on any desktop, any wallpaper. But a GDI
         region is a 1-bit mask: the edge it cuts is aliased, and a rim
         stroke CENTERED on the boundary loses its outer half to the cut,
         which read as a broken half-strength hairline. So the rim is now
         INSET: a 0.5px margin + 7.5px corner radius put the full 1px
         anti-aliased Outline line just INSIDE the region, where nothing
         clips it — the hard (aliased) OS cut lands exactly on the dark
         line, and the eye sees one crisp full-strength edge. WindowRoot
         still rounds + clips the content subtree to the same silhouette.
         THE BACKDROP IS B.OUTLINE ON PURPOSE: a GDI region is a 1-bit
         mask and a WPF arc is anti-aliased, so the two curves never
         coincide perfectly — at every corner a ~0.5px crescent of pixels
         sits between the rim arc and the OS cut. With a Surface backdrop
         that crescent painted the light content color OUTSIDE the dark
         line and read as "something sticking out at the edge"; with an
         Outline backdrop every such pixel is the line's own color, so
         the silhouette reads as one continuous dark edge running into
         the OS cut, on any wallpaper, in any theme.
         Maximized: MainWindow.ApplyChromeState squares the corners, drops
         the rim and pads the content back inside the visible work area.
         Live resize: MainWindow.EngageResizeFreeze shows the last fully
         rendered frame (FreezeLayer below) while the content tree is
         collapsed, which is what makes Win7 border drags smooth. -->
    <Border x:Name="WindowRoot" CornerRadius="8"
            Background="{DynamicResource B.Surface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ custom title bar (native drag/snap via WindowChrome) ============ -->
            <Grid Grid.Row="0" x:Name="ChromeGrid">
                <StackPanel x:Name="TitleBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- the real app icon — same artwork as the exe and
                         taskbar button, so the brand matches everywhere.
                         Rendered natively at exactly 24px (app.ico only
                         ships ico frames; this PNG is pixel-perfect here) -->
                    <Image Source="pack://application:,,,/Assets/app-24.png" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="FFX Compatibility Tool" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.OnSurface}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Style="{StaticResource ChromeButton}" ToolTip="Minimize">
                        <controls:IconGlyph IconName="Minimize" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource ChromeButton}" ToolTip="Maximize">
                        <controls:IconGlyph x:Name="MaxIcon" IconName="Maximize" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource ChromeCloseButton}" ToolTip="Close">
                        <controls:IconGlyph IconName="Close" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6"/>
            </Grid>

            <!-- ============ body: rail + page host ============ -->
            <Grid Grid.Row="1" x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:NavRail x:Name="Rail" Grid.Column="0"/>
                <ContentControl x:Name="PageHost" Grid.Column="1"/>
            </Grid>

            <!-- live-resize freeze frame: during a border drag the last
                 fully rendered frame is stretched here while the two
                 content grids above are collapsed (see MainWindow.cs) —
                 the rim below stays live so the silhouette never blurs -->
            <Image x:Name="FreezeLayer" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="15"
                   Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- anti-aliased rounded edge, drawn over every child. The
                 0.5px inset keeps the whole stroke inside the OS window
                 region (see the anatomy comment above): a boundary-centered
                 stroke used to lose its outer half to the 1-bit region cut
                 and read as a broken half-strength hairline -->
            <Border x:Name="WindowRim" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="16"
                    Margin="0.5" CornerRadius="7.5" BorderThickness="1"
                    BorderBrush="{DynamicResource B.Outline}"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
