<Window x:Class="FfxTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FfxTool.Gui"
        Title="FFX Compatibility Tool" Width="1180" Height="740"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Surface}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Custom window overlay (fully replaces the native frame).
         WindowStyle stays SingleBorderWindow ON PURPOSE: DWM only plays the
         Windows 7 minimize/maximize animations (and grants Aero Snap + live
         taskbar previews) to windows that carry WS_CAPTION, and the stock
         WindowChrome worker never re-adds it once WindowStyle="None"
         strips it - that is exactly why minimizing used to snap shut with
         no animation. WindowChrome still keeps the client area covering the
         whole window via WM_NCCALCSIZE, so the native frame is never drawn.

         SQUARE CORNERS, DELIBERATELY: rounds 5-9 chased a rounded silhouette
         with an OS-level region cut (SetWindowRgn) plus an anti-aliased rim
         stroke, and every variant still showed a stray crescent at the
         corners on the user's Windows 7 machine. The cause is structural -
         a GDI region is a 1-bit mask, WPF arcs are anti-aliased, so the two
         curves can never coincide pixel-for-pixel and ~0.5px of backdrop
         always survives between them. This build stops fighting physics:
         the window is a plain rectangle, the edge is a single 1px border
         (WindowRim) drawn just inside the client area, and the HWND IS the
         silhouette - there is no second curve left to disagree with, so
         nothing can ever stick out, on any OS, any DPI, any wallpaper.
         Classic Windows 7 apps (and AE itself on Windows) are square; the
         rounded look was never worth this cost.

         Resizing is the OS's own border drag again - the round-9 snapshot
         "freeze frame" (stretch the last rendered bitmap while the content
         tree is collapsed) read as blurry and is gone; the black-flash
         guards (WM_ERASEBKGND swallowed + WS_EX_COMPOSITED, see
         MainWindow.EnableComposited) stay.

         Maximized: MainWindow.ApplyChromeState pads the content back inside
         the visible work area (a maximized chromeless window overhangs the
         screen by the invisible resize border) and drops the rim. -->
    <Border x:Name="WindowRoot">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ custom title bar (native drag/snap via WindowChrome) ============
                 Compact caption: the native Win7/Win10 bar this app replaces
                 is ~30px, and 64px of custom chrome read as a second
                 header. 40px keeps the custom buttons comfortable while
                 the content starts where users expect it. -->
            <Grid Grid.Row="0" x:Name="ChromeGrid">
                <StackPanel x:Name="TitleBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- the real app icon - same artwork as the exe and
                         taskbar button, so the brand matches everywhere.
                         16px matches the caption height's icon proportions -->
                    <Image Source="pack://application:,,,/Assets/app-24.png" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="FFX Compatibility Tool" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.OnSurface}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinBtn" Style="{StaticResource ChromeButton}" ToolTip="Minimize">
                        <controls:IconGlyph IconName="Minimize" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource ChromeButton}" ToolTip="Maximize">
                        <controls:IconGlyph x:Name="MaxIcon" IconName="Maximize" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource ChromeCloseButton}" ToolTip="Close">
                        <controls:IconGlyph IconName="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6"/>
            </Grid>

            <!-- ============ body: rail + page host ============ -->
            <Grid Grid.Row="1" x:Name="BodyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:NavRail x:Name="Rail" Grid.Column="0"/>
                <ContentControl x:Name="PageHost" Grid.Column="1"/>
            </Grid>

            <!-- the entire window edge: one crisp 1px line just inside the
                 client rect. No corner radius, no region, no layered curves -
                 the silhouette and this line are the same rectangle, so the
                 "something sticking out at the edge" artifact is structurally
                 impossible now. Collapses while maximized (rimmed windows
                 floating inside the screen edge look wrong). -->
            <Border x:Name="WindowRim" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="16"
                    BorderThickness="1" BorderBrush="{DynamicResource B.Outline}"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
