<Window x:Class="FfxTool.Gui.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:FfxTool.Gui"
        Title="Software Update" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource B.Surface}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False">

    <!-- Same chrome recipe as MainWindow: WindowStyle stays SingleBorderWindow
         (Win7 minimize/DWM lessons) while WindowChrome eats the native frame,
         GlassFrameThickness="1" keeps the DWM shadow, and one 1px WindowRim
         inside the client rect is the whole window edge. A dialog is
         non-resizable, so none of the resize machinery is needed. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            GlassFrameThickness="1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== caption ===== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="pack://application:,,,/Assets/app-24.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Software Update" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.OnSurface}" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="CloseBtn" Style="{StaticResource ChromeButton}" ToolTip="Close"
                        Click="CloseBtn_Click">
                    <controls:IconGlyph IconName="Close" Width="14" Height="14"/>
                </Button>
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6"/>
        </Grid>

        <!-- ===== body: one visible state panel at a time ===== -->
        <Grid Grid.Row="1" Margin="24,20,24,24">

            <!-- ——— CHECKING ——— -->
            <StackPanel x:Name="CheckingPanel">
                <TextBlock Text="Checking for updates…" Style="{StaticResource SectionTitle}" FontSize="15"/>
                <TextBlock Text="Resolving the project's latest release on GitHub — one small lookup, nothing is sent."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                <!-- indeterminate sweep bar: a primary sliver glides across the
                     track while the redirect lookup is in flight -->
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.SCHighest}" ClipToBounds="True">
                    <Border x:Name="CheckSweep" Width="96" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{DynamicResource B.Primary}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CheckSweepMove" X="-96"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>

            <!-- ——— OFFER ——— -->
            <StackPanel x:Name="OfferPanel" Visibility="Collapsed">
                <!-- the version ladder: installed → available, vivi-style chips -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource B.SC}"
                            BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="1">
                        <TextBlock x:Name="FromChip" Text="v—" FontSize="12.5"
                                   Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"/>
                    </Border>
                    <controls:IconGlyph IconName="ChevRight" Width="18" Height="18" Margin="8,0"
                                        Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource B.PrimaryContainer}">
                        <TextBlock x:Name="ToChip" Text="v—" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.OnPrimaryContainer}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="OfferHeadline" Text="A new version is ready." FontSize="14.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource B.OnSurface}" Margin="0,14,0,0"/>
                <TextBlock x:Name="OfferDescription" Style="{StaticResource BodySecondary}"
                           TextWrapping="Wrap" Margin="0,5,0,0"/>

                <!-- what's new: the release's changelog.json entry, rendered -->
                <TextBlock Text="What's new" Style="{StaticResource SectionTitle}" FontSize="13.5" Margin="0,16,0,8"/>
                <Border Background="{DynamicResource B.SC}" CornerRadius="14" Padding="16,12">
                    <ScrollViewer MaxHeight="268" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="OfferSections"/>
                    </ScrollViewer>
                </Border>

                <TextBlock x:Name="NightlyNote" Visibility="Collapsed" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource B.OnSurfaceVariant}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="This build is a nightly — installing a stable release replaces it."/>
                <TextBlock x:Name="NoDownloadNote" Visibility="Collapsed" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource B.OnSurfaceVariant}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="This release's file name couldn't be confirmed — grab it straight from the release page."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="LaterButton" Style="{StaticResource OutlinedButton}" Content="Later"
                            Width="90" Margin="0,0,10,0" Click="CloseBtn_Click"/>
                    <Button x:Name="ReleasePageButton" Style="{StaticResource OutlinedButton}"
                            Content="Release page" MinWidth="122" Margin="0,0,10,0" Click="ReleasePage_Click"
                            ToolTip="Opens this release's page in your browser"/>
                    <Button x:Name="DownloadButton" Content="Download Update" MinWidth="168"
                            Click="Download_Click"
                            ToolTip="Downloads the new exe, checks it against the release's SHA-256 and stages it — nothing on your machine changes until you restart"/>
                </StackPanel>
            </StackPanel>

            <!-- ——— PROGRESS ——— -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressHeadline" Text="Downloading…" Style="{StaticResource SectionTitle}" FontSize="15"/>

                <!-- stage chips: Check → Download → Verify → Restart. The
                     Restart chip's icon is the app's own swap glyph — the
                     literal thing that happens to the exe. -->
                <StackPanel x:Name="StageRow" Orientation="Horizontal" Margin="0,14,0,0"/>

                <!-- the AE-timeline progress: rounded track, primary fill,
                     and a playhead line that rides the fill's edge and
                     overhangs the track like the real thing -->
                <Grid x:Name="TrackGrid" Height="18" Margin="0,18,0,0">
                    <Border Background="{DynamicResource B.SCHighest}" CornerRadius="4.5"/>
                    <Border x:Name="FillBar" Background="{DynamicResource B.Primary}" CornerRadius="4.5"
                            HorizontalAlignment="Left" Width="0"/>
                    <Border x:Name="Playhead" Width="2.5" Height="26" CornerRadius="1.25"
                            Background="{DynamicResource B.OnSurface}" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PlayheadMove" X="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressStageText" Grid.Column="0" Style="{StaticResource Caption}"
                               Text="Contacting the release servers…" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProgressStats" Grid.Column="1" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource B.OnSurfaceVariant}" Margin="12,0,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource OutlinedButton}" Content="Cancel"
                            Width="110" Click="Cancel_Click"
                            ToolTip="Stops the download and throws the partial file away"/>
                </StackPanel>
            </StackPanel>

            <!-- ——— READY TO RESTART ——— -->
            <StackPanel x:Name="ReadyPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <controls:IconGlyph IconName="Verified" Width="26" Height="26"
                                        Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ReadyHeadline" Text="Downloaded and verified" Style="{StaticResource SectionTitle}"
                               FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ReadyBody" Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="The new exe is staged and hash-checked against the release. Restart now — the app swaps itself in place and relaunches. Nothing else on your machine changes."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="NotNowButton" Style="{StaticResource OutlinedButton}" Content="Not Now"
                            Width="100" Margin="0,0,10,0" Click="CloseBtn_Click"/>
                    <Button x:Name="RestartButton" Content="Restart and Update" MinWidth="160" Click="Restart_Click"
                            ToolTip="Swaps the new exe over the old one and relaunches"/>
                </StackPanel>
            </StackPanel>

            <!-- ——— UP TO DATE ——— -->
            <StackPanel x:Name="UpToDatePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <controls:IconGlyph IconName="Check" Width="22" Height="22"
                                        Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                    <TextBlock Text="You're up to date" Style="{StaticResource SectionTitle}" FontSize="15"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="UpToDateMessage" Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                           Margin="0,10,0,18"/>
                <Button Content="Close" Width="100" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </StackPanel>

            <!-- ——— ERROR ——— -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <controls:IconGlyph IconName="Warning" Width="22" Height="22"
                                        Foreground="{DynamicResource B.Error}" VerticalAlignment="Center"/>
                    <TextBlock Text="The update hit a snag" Style="{StaticResource SectionTitle}" FontSize="15"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                           Margin="0,10,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ErrorCloseButton" Style="{StaticResource OutlinedButton}" Content="Close"
                            Width="90" Margin="0,0,10,0" Click="CloseBtn_Click"/>
                    <Button x:Name="ErrorRetryButton" Content="Try Again" MinWidth="120" Click="Retry_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- the whole window edge, same as MainWindow -->
        <Border x:Name="WindowRim" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="16"
                BorderThickness="1" BorderBrush="{DynamicResource B.Outline}" IsHitTestVisible="False"/>
    </Grid>
</Window>
