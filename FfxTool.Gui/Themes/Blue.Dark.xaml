<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- M3 Expressive 2026 — Blue seed, Dark mode (values trace to the original design spec) -->
    <Color x:Key="P.Primary">#A9C7FF</Color>
    <Color x:Key="P.OnPrimary">#00315C</Color>
    <Color x:Key="P.PrimaryContainer">#00478A</Color>
    <Color x:Key="P.OnPrimaryContainer">#D3E3FD</Color>
    <Color x:Key="P.Surface">#111318</Color>
    <Color x:Key="P.SCLowest">#0C0E13</Color>
    <Color x:Key="P.SCLow">#191C21</Color>
    <Color x:Key="P.SC">#1D2024</Color>
    <Color x:Key="P.SCHigh">#282A2F</Color>
    <Color x:Key="P.SCHighest">#33353B</Color>
    <Color x:Key="P.OnSurface">#E2E2E9</Color>
    <Color x:Key="P.OnSurfaceVariant">#C4C6D0</Color>
    <Color x:Key="P.Outline">#8E9099</Color>
    <Color x:Key="P.OutlineVariant">#44474E</Color>
    <Color x:Key="P.Error">#FFB4AB</Color>
    <Color x:Key="P.ErrorContainer">#93000A</Color>
    <Color x:Key="P.OnErrorContainer">#FFDAD6</Color>
    <Color x:Key="P.TertiaryContainer">#5750E8</Color>
    <Color x:Key="P.OnTertiaryContainer">#E2DEFF</Color>
    <SolidColorBrush x:Key="B.Primary" Color="{StaticResource P.Primary}"/>
    <SolidColorBrush x:Key="B.OnPrimary" Color="{StaticResource P.OnPrimary}"/>
    <SolidColorBrush x:Key="B.PrimaryContainer" Color="{StaticResource P.PrimaryContainer}"/>
    <SolidColorBrush x:Key="B.OnPrimaryContainer" Color="{StaticResource P.OnPrimaryContainer}"/>
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource P.Surface}"/>
    <SolidColorBrush x:Key="B.SCLowest" Color="{StaticResource P.SCLowest}"/>
    <SolidColorBrush x:Key="B.SCLow" Color="{StaticResource P.SCLow}"/>
    <SolidColorBrush x:Key="B.SC" Color="{StaticResource P.SC}"/>
    <SolidColorBrush x:Key="B.SCHigh" Color="{StaticResource P.SCHigh}"/>
    <SolidColorBrush x:Key="B.SCHighest" Color="{StaticResource P.SCHighest}"/>
    <SolidColorBrush x:Key="B.OnSurface" Color="{StaticResource P.OnSurface}"/>
    <SolidColorBrush x:Key="B.OnSurfaceVariant" Color="{StaticResource P.OnSurfaceVariant}"/>
    <SolidColorBrush x:Key="B.Outline" Color="{StaticResource P.Outline}"/>
    <SolidColorBrush x:Key="B.OutlineVariant" Color="{StaticResource P.OutlineVariant}"/>
    <SolidColorBrush x:Key="B.Error" Color="{StaticResource P.Error}"/>
    <SolidColorBrush x:Key="B.ErrorContainer" Color="{StaticResource P.ErrorContainer}"/>
    <SolidColorBrush x:Key="B.OnErrorContainer" Color="{StaticResource P.OnErrorContainer}"/>
    <SolidColorBrush x:Key="B.TertiaryContainer" Color="{StaticResource P.TertiaryContainer}"/>
    <SolidColorBrush x:Key="B.OnTertiaryContainer" Color="{StaticResource P.OnTertiaryContainer}"/>
</ResourceDictionary>
