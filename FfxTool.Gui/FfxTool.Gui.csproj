<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF on net48: WPF ships inside .NET Framework 4.8, so Windows 7
         SP1 support is preserved (the whole point of net48 here) while
         gaining real vector rendering, layout, animation and chrome. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FfxTool.Gui</AssemblyName>
    <RootNamespace>FfxTool.Gui</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- .NET Framework never reads the deps.json at runtime (that is a
         .NET Core mechanism) — skip it so the packed Release output is
         exactly one file (see the ILRepack step at the bottom). -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- exact-size in-app brand marks (title bar / nav rail / About) -->
    <Resource Include="Assets\app-24.png" />
    <Resource Include="Assets\app-36.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FfxTool.Core\FfxTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the mirrored-output ZIP (System.IO.Compression.ZipFile) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single-exe packing: merges FfxTool.Core.dll and the
         System.Text.Json dependency chain INTO FfxTool.Gui.exe so the
         portable build is one file (Release only — Debug stays unpacked
         for debugging). /allowDup tolerates the identical internal
         nullable-annotation attributes the netstandard2.0 packages each
         embed; /ndebug skips pdb merging. -->
    <PackageReference Include="ILRepack" Version="2.0.18" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackIntoSingleExe" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_MergeDll Include="$(OutputPath)*.dll" />
    </ItemGroup>
    <Error Condition="'$(PkgILRepack)' == ''" Text="ILRepack could not be resolved from the package cache — run dotnet restore FfxTool.sln first." />
    <Message Condition="'@(_MergeDll)' == ''" Importance="high" Text="Single-exe packing: no dependency DLLs beside the output — FfxTool.Gui.exe is already packed." />
    <Message Condition="'@(_MergeDll)' != ''" Importance="high" Text="Single-exe packing: merging @(_MergeDll->Count()) DLL(s) into FfxTool.Gui.exe." />
    <MakeDir Condition="'@(_MergeDll)' != ''" Directories="$(OutputPath)_merged" />
    <Exec Condition="'@(_MergeDll)' != ''" Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /allowDup /ndebug /out:&quot;$(OutputPath)_merged\$(TargetFileName)&quot; &quot;$(TargetPath)&quot; @(_MergeDll->'&quot;%(FullPath)&quot;', ' ')" />
    <Copy Condition="'@(_MergeDll)' != ''" SourceFiles="$(OutputPath)_merged\$(TargetFileName)" DestinationFiles="$(TargetPath)" />
    <Delete Condition="'@(_MergeDll)' != ''" Files="$(OutputPath)$(TargetFileName).pdb;@(_MergeDll)" />
    <Delete Condition="'@(_MergeDll)' != ''" Files="@(_MergeDll->'%(RootDir)%(Directory)%(Filename).pdb')" />
    <RemoveDir Condition="'@(_MergeDll)' != ''" Directories="$(OutputPath)_merged" />
  </Target>

</Project>
