<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF on net48: WPF ships inside .NET Framework 4.8, so Windows 7
         SP1 support is preserved (the whole point of net48 here) while
         gaining real vector rendering, layout, animation and chrome. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FfxTool.Gui</AssemblyName>
    <RootNamespace>FfxTool.Gui</RootNamespace>
    <Version>1.0.31</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- exact-size in-app brand marks (title bar / nav rail / About) -->
    <Resource Include="Assets\app-24.png" />
    <Resource Include="Assets\app-36.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FfxTool.Core\FfxTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\data\plugin_table.json" CopyToOutputDirectory="PreserveNewest" Link="data\plugin_table.json" />
    <None Include="..\data\effect_names.json" CopyToOutputDirectory="PreserveNewest" Link="data\effect_names.json" />
  </ItemGroup>

</Project>
