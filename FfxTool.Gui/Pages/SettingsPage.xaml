<UserControl x:Class="FfxTool.Gui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui">
    <!-- Sub-settings hub: left sub-nav (Appearance / Plugin Profiles / About),
         right content pane. The Plugin Profiles view hosts the existing
         ProfilePage instance verbatim — all of its logic stays. -->
    <Grid Margin="32,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" Style="{StaticResource TitlePage}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage your preferences and system configuration." Style="{StaticResource BodySecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sub-nav -->
            <ListBox x:Name="SubNav" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0"
                     SelectionChanged="SubNav_SelectionChanged">
                <ListBoxItem x:Name="NavAppearance" IsSelected="True" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Palette" Width="19" Height="19"
                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Appearance" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavProfile" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Plugin" Width="19" Height="19"
                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Plugin Profiles" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavAbout" Padding="12,10">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Info" Width="19" Height="19"
                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                        <TextBlock Text="About" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- sub-content -->
            <Grid Grid.Column="1">
                <!-- ===== Appearance ===== -->
                <Grid x:Name="AppearanceView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Palette" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- dark mode row -->
                                <Border Background="{DynamicResource B.SC}" CornerRadius="14" Padding="18,12" Margin="0,0,0,22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Dark Mode" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Switch between light and dark UI themes" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DarkSwitch" Grid.Column="1" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Color palette" Style="{StaticResource SectionTitle}" FontSize="13.5" Margin="0,0,0,14"/>
                                <StackPanel x:Name="PaletteRow" Orientation="Horizontal"/>

                                <TextBlock x:Name="RestoreLink" Text="Restore Defaults" Style="{StaticResource M3Link}"
                                           Margin="0,22,0,0" MouseLeftButtonUp="Restore_Click"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Plugin Profiles (embedded existing page) ===== -->
                <ContentControl x:Name="ProfileHost" Visibility="Collapsed" Margin="4,0,0,0"/>

                <!-- ===== About ===== -->
                <Grid x:Name="AboutView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardElevated}" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SC}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Info" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.OnSurfaceVariant}"/>
                                    </Border>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource B.Surface}"
                                            BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="1">
                                        <controls:IconGlyph IconName="Logo" Width="30" Height="30"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FFX Compatibility Tool" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6" Margin="0,0,0,14"/>

                                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                                           Text="A professional-grade utility designed for motion designers and video editors."/>
                                <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource B.Primary}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="This tool specializes in downgrading After Effects presets (.ffx) to ensure cross-version compatibility."/>
                                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,18"
                                           Text="Designed with precision to maintain keyframe data and expression integrity across different software generations."/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check for Updates" Width="170" IsEnabled="False" Margin="0,0,10,0"
                                            ToolTip="Not yet implemented — no update server exists for this app yet"/>
                                    <Button Content="Logs" Style="{StaticResource OutlinedButton}" Width="90" IsEnabled="False"
                                            ToolTip="Not yet implemented — Convert's console output isn't persisted to a log file yet"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
