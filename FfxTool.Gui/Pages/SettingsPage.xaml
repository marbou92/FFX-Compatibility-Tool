<UserControl x:Class="FfxTool.Gui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui">
    <!-- Sub-settings hub: left sub-nav (Appearance / Plugin Profiles / About),
         right content pane. The Plugin Profiles view hosts the existing
         ProfilePage instance verbatim — all of its logic stays. -->
    <Grid Margin="32,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" Style="{StaticResource TitlePage}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage your preferences and system configuration." Style="{StaticResource BodySecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sub-nav -->
            <ListBox x:Name="SubNav" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,16,0"
                     SelectionChanged="SubNav_SelectionChanged">
                <!-- 4px bottom margin: with the template now honouring Padding,
                     items would otherwise stack pill-against-pill with no seam. -->
                <ListBoxItem x:Name="NavAppearance" IsSelected="True" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <!-- crisp contrast glyph (palette art turned to
                             mush at 19px); glyph + label inherit the item
                             Foreground: OnSurface at rest, flipping to
                             OnPrimaryContainer inside the selected pill
                             (M3 active-indicator spec — a pinned Primary
                             here sat teal-on-teal). -->
                        <controls:IconGlyph IconName="Contrast" Width="19" Height="19"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="Appearance" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <!-- Storage sits directly below Appearance: the two
                     machine-local pages first (theme, then disk), the
                     catalog/about pages after. -->
                <ListBoxItem x:Name="NavStorage" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Storage" Width="19" Height="19"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="Storage" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavProfile" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Plugin" Width="19" Height="19"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="Plugin Profiles" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="NavAbout" Padding="12,10" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconGlyph IconName="Info" Width="19" Height="19"
                                            VerticalAlignment="Center"/>
                        <TextBlock Text="About" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- sub-content -->
            <Grid Grid.Column="1">
                <!-- ===== Appearance ===== -->
                <Grid x:Name="AppearanceView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Top-aligned: without it the card stretches to the
                         viewport and leaves a slab of dead space below the
                         content when the window is taller than the page. -->
                        <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Contrast" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- dark mode row -->
                                <Border Background="{DynamicResource B.SC}" CornerRadius="14" Padding="18,12" Margin="0,0,0,22">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Dark Mode" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Switch between light and dark UI themes" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DarkSwitch" Grid.Column="1" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Color palette" Style="{StaticResource SectionTitle}" FontSize="13.5" Margin="0,0,0,14"/>
                                <StackPanel x:Name="PaletteRow" Orientation="Horizontal"/>

                                <TextBlock x:Name="RestoreLink" Text="Restore Defaults" Style="{StaticResource M3Link}"
                                           Margin="0,22,0,0" MouseLeftButtonUp="Restore_Click"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Storage ===== -->
                <Grid x:Name="StorageView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Storage" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Text="Everything this tool keeps between sessions lives in %APPDATA%\FFXCompatibilityTool. Both of these are safe to delete — the scan catalog rebuilds on the next plugin scan and the history fills up again as presets are analyzed."/>

                                <!-- cache row -->
                                <Border Background="{DynamicResource B.SC}" CornerRadius="14" Padding="18,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cache" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Plugin scan catalog — rebuilt by the next system scan"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CacheInfo" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                       Opacity="0.85" Margin="0,2,0,0" Text="Plugin scan catalog"/>
                                        </StackPanel>
                                        <Button x:Name="ClearCacheButton" Grid.Column="1" Content="Delete"
                                                Style="{StaticResource OutlinedButton}" MinWidth="96"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Click="ClearCache_Click"
                                                ToolTip="Deletes plugin_catalog.txt — recognition falls back to the reference tables until the next scan"/>
                                    </Grid>
                                </Border>

                                <!-- history row -->
                                <Border Background="{DynamicResource B.SC}" CornerRadius="14" Padding="18,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="History" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Recently opened presets — the last 5 analyzed .ffx files"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                       Opacity="0.85" Margin="0,2,0,0" Text="Recently opened presets"/>
                                        </StackPanel>
                                        <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="Delete"
                                                Style="{StaticResource OutlinedButton}" MinWidth="96"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Click="ClearHistory_Click"
                                                ToolTip="Deletes recent_files.json — the recent list empties and refills as presets are analyzed"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Open Storage Folder" Style="{StaticResource M3Link}" Cursor="Hand"
                                               MouseLeftButtonUp="OpenFolder_Click"
                                               ToolTip="Opens %APPDATA%\FFXCompatibilityTool in Explorer — console logs live here too"/>
                                </StackPanel>

                                <TextBlock Text="Appearance and plugin-profile preferences are kept."
                                           Style="{StaticResource Caption}" Margin="0,10,0,0" Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Plugin Profiles (embedded existing page) ===== -->
                <ContentControl x:Name="ProfileHost" Visibility="Collapsed" Margin="4,0,0,0"/>

                <!-- ===== About ===== -->
                <Grid x:Name="AboutView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardElevated}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Info" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource B.Surface}"
                                            BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="1">
                                        <Image Source="pack://application:,,,/Assets/app-36.png" Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FFX Compatibility Tool" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6" Margin="0,0,0,14"/>

                                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                                           Text="A professional-grade utility designed for motion designers and video editors."/>
                                <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource B.Primary}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Text="This tool specializes in downgrading After Effects presets (.ffx) to ensure cross-version compatibility."/>
                                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,8,0,18"
                                           Text="Designed with precision to maintain keyframe data and expression integrity across different software generations."/>

                                <TextBlock Text="Project links" Style="{StaticResource SectionTitle}" FontSize="13.5" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" Cursor="Hand" Margin="0,0,26,0"
                                                MouseLeftButtonUp="RepoLink_Click" ToolTip="Opens github.com in your browser">
                                        <controls:IconGlyph IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="GitHub repository" Style="{StaticResource M3Link}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Cursor="Hand"
                                                MouseLeftButtonUp="IssueLink_Click" ToolTip="Opens GitHub in your browser">
                                        <controls:IconGlyph IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Report an issue" Style="{StaticResource M3Link}"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check for Updates" Width="170" IsEnabled="False" Margin="0,0,10,0"
                                            ToolTip="Not yet implemented — no update server exists for this app yet"/>
                                    <Button Content="Logs" Style="{StaticResource OutlinedButton}" Width="90"
                                            Click="Logs_Click"
                                            ToolTip="Opens the folder where console output is saved"/>
                                </StackPanel>
                                <TextBlock Text="Every conversion session is journaled to %APPDATA%\FFXCompatibilityTool\logs."
                                           Style="{StaticResource Caption}" Margin="0,12,0,0" Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
