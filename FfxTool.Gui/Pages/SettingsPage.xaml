<UserControl x:Class="FfxTool.Gui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui">
    <!-- Sub-settings hub, 0.2.2 second pass: five sub-pages now —
         Appearance, Storage, Plugin Profiles, Updates and About. The
         update machinery moved out of About into its own Updates page in
         the vivi-music "Update Settings" shape: status rows (system
         update / app version / flavour), behavior switches (auto check /
         include nightlies / notifications), a clear-downloads row and a
         history group whose Changelog row drills into a version-pill
         viewer fed straight from GitHub's release list. About keeps only
         the identity row, the specs chips and the project links. Every
         boolean row carries a real Md3Switch and tracks the palette like
         everything else; the marks that aren't controls (the palette
         swatch's pick, the profile card badges) wear check chips. -->
    <UserControl.Resources>
        <!-- Sub-nav item: NO selected pill of its own — the floating
             SubNavPill behind the ListBox is the selected indicator and
             slides between items. The item only carries a faint hover
             state layer (over the pill, NavRail-style) and the M3
             foreground flip. Explicit style (not implicit): a hosted
             ProfilePage must never pick this up through the tree. -->
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusVisual}"/>
            <Setter Property="Foreground" Value="{DynamicResource B.OnSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="StateLayer" Background="{DynamicResource B.OnSurface}"
                                    CornerRadius="10" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B.OnPrimaryContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the Light/Dark/System control -->
        <Style x:Key="SettingsSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.OnSurface}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource M3FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="16"/>
                            <Border x:Name="StateLayer" Background="{DynamicResource B.OnSurface}"
                                    CornerRadius="16" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource B.PrimaryContainer}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.OnPrimaryContainer}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.07"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings" Style="{StaticResource TitlePage}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage your preferences and system configuration." Style="{StaticResource BodySecondary}"/>
        </StackPanel>

        <!-- ===== search (suggestion 4): filters across every sub-page;
              picking a result navigates there and flashes the row.
              ZIndex lifts the whole search area (box + results dropdown)
              above the content grid — Z-order only applies between
              siblings, and the results must overlay the pages below. ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,16" Panel.ZIndex="20">
            <Border x:Name="SearchBoxHost" Background="{DynamicResource B.SC}" CornerRadius="14"
                    Padding="13,9" MaxWidth="760" HorizontalAlignment="Left" Width="420">
                <StackPanel Orientation="Horizontal">
                    <controls:IconGlyph IconName="Search" Width="16" Height="16"
                                        Foreground="{DynamicResource B.OnSurfaceVariant}"
                                        VerticalAlignment="Center"/>
                    <Grid Margin="10,0,0,0" VerticalAlignment="Center" Width="360">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Padding="0" FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Searches every Settings tab — Enter jumps to the first match"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Search settings — try &quot;cache&quot;, &quot;theme&quot;, &quot;updates&quot;"
                                   Style="{StaticResource Caption}" Margin="1,0,0,0"
                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <!-- results dropdown: overlays the content below the box -->
            <Border x:Name="SearchResults" Background="{DynamicResource B.SCLowest}" CornerRadius="14"
                    BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="1"
                    Padding="6" MaxWidth="760" HorizontalAlignment="Left" Width="420"
                    MaxHeight="280" VerticalAlignment="Top" Margin="0,46,0,0"
                    Visibility="Collapsed" Panel.ZIndex="20">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Direction="270" Opacity="0.3"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SearchResultsList"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== sub-nav with the sliding indicator (suggestion 2) ===== -->
            <Grid Grid.Column="0" x:Name="SubNavHost" Margin="0,0,16,0" VerticalAlignment="Stretch">
                <!-- the floating M3 active-indicator pill: behind the ListBox,
                     moved by code with the NavRail's spring -->
                <Canvas x:Name="SubNavPillLayer" IsHitTestVisible="False">
                    <Border x:Name="SubNavPill" Canvas.Left="8" Width="196" Height="40"
                            CornerRadius="10" Background="{DynamicResource B.PrimaryContainer}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SubNavPillMove" Y="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
                <StackPanel VerticalAlignment="Top">
                    <ListBox x:Name="SubNav" SelectionChanged="SubNav_SelectionChanged">
                    <ListBoxItem x:Name="NavAppearance" Style="{StaticResource SettingsNavItem}"
                                 IsSelected="True" Padding="12,10" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Contrast" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavStorage" Style="{StaticResource SettingsNavItem}"
                                 Padding="12,10" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Storage" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="Storage" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavProfile" Style="{StaticResource SettingsNavItem}"
                                 Padding="12,10" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Plugin" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="Plugin Profiles" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavUpdates" Style="{StaticResource SettingsNavItem}"
                                 Padding="12,10" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Refresh" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="Updates" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <!-- the update-found dot: a silent find lights this
                                 up even with the toast switched off -->
                            <Border x:Name="NavUpdatesDot" Width="8" Height="8" CornerRadius="4"
                                    Background="{DynamicResource B.Primary}" VerticalAlignment="Center"
                                    Margin="9,0,0,0" Visibility="Collapsed"
                                    ToolTip="An update is waiting on the Updates tab"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavAbout" Style="{StaticResource SettingsNavItem}"
                                 Padding="12,10" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Info" Width="19" Height="19" VerticalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                    <!-- keyboard hint for the shortcuts (suggestion 22) -->
                    <TextBlock Text="Alt+1–5 switches tabs" Style="{StaticResource Caption}"
                               Margin="12,12,0,0" Opacity="0.8"/>
                </StackPanel>
            </Grid>

            <!-- sub-content -->
            <Grid Grid.Column="1">

                <!-- ==================== Appearance ==================== -->
                <Grid x:Name="AppearanceView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Contrast" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- MODE group: Light / Dark / System as a 3-way
                                     segmented control (suggestion 8) — picking
                                     Light or Dark turns system-follow off,
                                     System hands the mode to the OS -->
                                <TextBlock Text="MODE" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>
                                <Border Background="{DynamicResource B.SC}" CornerRadius="20" Padding="4"
                                        HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SegLight" GroupName="ThemeMode" Padding="16,7"
                                                     Style="{StaticResource SettingsSegment}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconGlyph IconName="LightMode" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Light" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SegDark" GroupName="ThemeMode" Padding="16,7"
                                                     Style="{StaticResource SettingsSegment}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconGlyph IconName="DarkMode" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Dark" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SegSystem" GroupName="ThemeMode" Padding="16,7"
                                                     Style="{StaticResource SettingsSegment}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconGlyph IconName="Settings" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="System" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="System follows the Windows app setting and updates live — the segments above hand the mode back to you."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,22"
                                           MaxWidth="520" HorizontalAlignment="Left"/>

                                <!-- PALETTE group: the swatches carry the
                                     check chip (built in code) — an 18px
                                     primary circle with a white check —
                                     because a pick is a chosen state, not
                                     a toggle -->
                                <TextBlock Text="PALETTE" Style="{StaticResource GroupHeader}" Margin="0,0,0,12"/>
                                <StackPanel x:Name="PaletteRow" Orientation="Horizontal" Margin="0,0,0,22"/>

                                <!-- PREVIEW group: the theme applied to real
                                     controls — DynamicResource re-themes it
                                     instantly on every palette/mode change -->
                                <TextBlock Text="PREVIEW" Style="{StaticResource GroupHeader}" Margin="0,0,0,12"/>
                                <Border x:Name="PreviewCard" Style="{StaticResource CardOutlined}" CornerRadius="16" Padding="18"
                                        Margin="0,0,0,22">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.OutlineVariant}" VerticalAlignment="Center"/>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.OutlineVariant}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.OutlineVariant}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="untitled.aep" Style="{StaticResource Caption}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Height="1" Background="{DynamicResource B.OutlineVariant}" Opacity="0.6" Margin="0,0,0,14"/>
                                        <TextBlock Text="The quick brown fox jumps over the lazy dog."
                                                   Style="{StaticResource Body}" FontSize="13.5" Margin="0,0,0,14"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Convert" Height="34" MinWidth="110"/>
                                            <Button Content="Browse" Style="{StaticResource OutlinedButton}"
                                                    Height="34" MinWidth="96" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <!-- the live switch demo, solo: the demo
                                             checkbox that used to sit beside it is
                                             gone — booleans are switches now, and
                                             one honest switch beats two rivals -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <ToggleButton Style="{StaticResource Md3Switch}" IsChecked="True"
                                                          VerticalAlignment="Center"
                                                          ToolTip="A live switch — click it, it's real"/>
                                            <TextBlock Text="Every boolean in this app is a switch like this one."
                                                       Style="{StaticResource Caption}" Margin="14,0,0,0"
                                                       VerticalAlignment="Center" Opacity="0.85"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Restore defaults as a real two-step button
                                     (suggestion 11) instead of a bare link -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RestoreButton" Style="{StaticResource OutlinedButton}"
                                            Content="Restore defaults" MinWidth="150"
                                            Click="RestoreButton_Click"
                                            ToolTip="Resets to Light · Teal · system-follow off — click again to confirm"/>
                                    <TextBlock Text="Back to Light · Teal · follow-system off"
                                               Style="{StaticResource Caption}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Opacity="0.85"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== Storage ==================== -->
                <Grid x:Name="StorageView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Storage" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Text="Everything this tool keeps between sessions lives in %APPDATA%\FFXCompatibilityTool. All of it is safe to delete — the scan catalog rebuilds on the next plugin scan and the history fills up again as presets are analyzed."/>

                                <!-- DISK USAGE group: a stacked meter of the
                                     three data stores (suggestion 12) -->
                                <TextBlock Text="DISK USAGE" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>
                                <Border x:Name="MeterRow" Style="{StaticResource SettingsRow}" Padding="18,14" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid x:Name="MeterGrid" Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="MeterCacheCol" Width="1*"/>
                                                <ColumnDefinition x:Name="MeterHistoryCol" Width="1*"/>
                                                <ColumnDefinition x:Name="MeterLogsCol" Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" x:Name="MeterCache" Background="{DynamicResource B.Primary}" CornerRadius="5,0,0,5"/>
                                            <Border Grid.Column="1" x:Name="MeterHistory" Background="{DynamicResource B.TertiaryContainer}"/>
                                            <Border Grid.Column="2" x:Name="MeterLogs" Background="{DynamicResource B.OutlineVariant}" CornerRadius="0,5,5,0"/>
                                        </Grid>
                                        <TextBlock x:Name="MeterEmpty" Text="Nothing stored yet — scan a plugin system or analyze a preset."
                                                   Style="{StaticResource Caption}" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MeterLegendCache" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource B.TertiaryContainer}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MeterLegendHistory" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource B.OutlineVariant}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MeterLegendLogs" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- MAINTENANCE group -->
                                <TextBlock Text="MAINTENANCE" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>

                                <!-- cache row — leads with the same icon
                                     tile as every other settings row -->
                                <Border x:Name="CacheRow" Style="{StaticResource SettingsRow}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="List" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Plugin scan catalog" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Recognition cache — rebuilt by the next system scan"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="CacheInfo" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                       Opacity="0.85" Margin="0,2,0,0" Text="plugin_catalog.txt"/>
                                        </StackPanel>
                                        <Button x:Name="CacheDeleteButton" Grid.Column="2" Content="Delete" MinWidth="118"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Click="CacheDeleteButton_Click"
                                                ToolTip="Deletes plugin_catalog.txt — recognition falls back to the reference tables until the next scan"/>
                                    </Grid>
                                </Border>

                                <!-- verbose logging row: the checkbox became a
                                     switch, and the whole row toggles it -->
                                <Border x:Name="VerboseRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="VerboseRow_Click"
                                        ToolTip="Toggles verbose logging">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Description" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Verbose Logging" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Per-file conversion steps in the session log — turn on when reporting a bug, off again afterwards"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="VerboseCheck" Grid.Column="2" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- history row -->
                                <Border x:Name="HistoryRow" Style="{StaticResource SettingsRow}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Schedule" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Recent presets" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Recently opened presets — the last 5 analyzed .ffx files"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="HistoryInfo" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                       Opacity="0.85" Margin="0,2,0,0" Text="recent_files.json"/>
                                        </StackPanel>
                                        <Button x:Name="HistoryDeleteButton" Grid.Column="2" Content="Delete" MinWidth="118"
                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                Click="HistoryDeleteButton_Click"
                                                ToolTip="Deletes recent_files.json — the recent list empties and refills as presets are analyzed"/>
                                    </Grid>
                                </Border>

                                <!-- consolidated file-location rows (suggestion 15):
                                     the storage folder AND the session logs live
                                     here now, not split across two pages -->
                                <Border x:Name="OpenFolderRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="OpenFolder_Click"
                                        ToolTip="Opens %APPDATA%\FFXCompatibilityTool in Explorer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="FolderOpen" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Open storage folder" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="%APPDATA%\FFXCompatibilityTool — the cache, the history and the logs"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="LogsRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,20"
                                        MouseLeftButtonUp="LogsRow_Click"
                                        ToolTip="Reveals today's console log in Explorer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="History" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Open session logs" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="console-YYYY-MM-DD.log — verbose logging writes here too"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Appearance and plugin-profile preferences are kept."
                                           Style="{StaticResource Caption}" Margin="0,0,0,0" Opacity="0.85"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== Plugin Profiles ====================
                     the embedded page, wrapped in the same chrome as its
                     sibling sub-pages (suggestion 16) — and now really the
                     same chrome: the title row lives INSIDE the card like
                     every other tab (it used to float above the card on
                     the bare background, with a tighter 18px padding —
                     the one header in Settings that didn't belong), the
                     card runs the default 24, and the embedded page's
                     own ScrollViewer fills the rest -->
                <Grid x:Name="ProfileView" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" MaxWidth="760">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
                                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                        VerticalAlignment="Center">
                                    <controls:IconGlyph IconName="Plugin" Width="22" Height="22"
                                                        Foreground="{DynamicResource B.Primary}"/>
                                </Border>
                                <TextBlock Text="Plugin Profiles" Style="{StaticResource SectionTitle}" FontSize="17"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ContentControl x:Name="ProfileHost" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== Updates ====================
                     the vivi-music "Update Settings" page: the update
                     machinery out of About, laid out as status rows,
                     behavior switches, a maintenance row and a history
                     group. The Changelog row drills into the version-pill
                     viewer (ChangelogPane below). -->
                <Grid x:Name="UpdatesView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Refresh" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- STATUS group -->
                                <TextBlock Text="STATUS" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>

                                <!-- the one update row: the old status card's
                                     four faces folded into a value + an
                                     expandable detail strip. Click = check now
                                     (or open the updater when something's
                                     already waiting). -->
                                <Border x:Name="UpdateStatusRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="UpdateStatusRow_Click"
                                        ToolTip="Checks GitHub's releases page — or opens the updater when an update is waiting">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Refresh" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="System update" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock x:Name="UpdateCheckedCaption" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Text="No check has run this session"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:IconGlyph x:Name="UpdateStatusSpinner" IconName="Refresh" Width="15" Height="15"
                                                                Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                                VerticalAlignment="Center" Visibility="Collapsed"
                                                                RenderTransformOrigin="0.5,0.5">
                                                <controls:IconGlyph.RenderTransform>
                                                    <RotateTransform x:Name="StatusSpin" Angle="0"/>
                                                </controls:IconGlyph.RenderTransform>
                                            </controls:IconGlyph>
                                            <Border x:Name="UpdateStatusPill" Background="{DynamicResource B.SCHigh}" CornerRadius="9"
                                                    Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="UpdateStatusValue" Text="Not checked yet" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- the detail strip: visible only when a
                                     check came back with something to say -->
                                <Border x:Name="UpdateDetailPanel" Background="{DynamicResource B.SCLow}" CornerRadius="12"
                                        Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateAvailSub" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="UpdateOpenButton" Content="See what's new" Style="{StaticResource TonalButton}"
                                                    MinWidth="130" Click="UpdateOpenButton_Click"
                                                    ToolTip="Opens the updater — it shows the release's what's-new notes and can download, verify and install it in place"/>
                                            <TextBlock x:Name="UpdatePageLink" Text="Release page" Style="{StaticResource M3Link}"
                                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                                       MouseLeftButtonUp="UpdatePageLink_Click"/>
                                            <TextBlock x:Name="UpdateSkipLink" Text="Skip this version" Style="{StaticResource M3Link}"
                                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                                       MouseLeftButtonUp="UpdateSkipLink_Click"
                                                       ToolTip="Stay quiet about this version — the next release speaks up again"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- app version: click copies, chip confirms -->
                                <Border x:Name="AppVersionRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="AppVersionRow_Click"
                                        ToolTip="Click to copy the version number">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Description" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="App version" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock x:Name="AppVersionCaption" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Text="Click to copy"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="AppVersionChip" Background="{DynamicResource B.Primary}" CornerRadius="9"
                                                    Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:IconGlyph IconName="Check" Width="12" Height="12"
                                                                        Foreground="{DynamicResource B.OnPrimary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Copied" FontSize="11.5" Foreground="{DynamicResource B.OnPrimary}"
                                                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- the nightly hash runs ~55 chars —
                                                 trim it at the row edge and put
                                                 the full string on hover; click
                                                 still copies it whole -->
                                            <TextBlock x:Name="AppVersionValue" Style="{StaticResource Body}"
                                                       Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"
                                                       MaxWidth="230" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- flavour: which kind of build this exe is -->
                                <Border x:Name="FlavourRow" Style="{StaticResource SettingsRow}" Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Diamond" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Flavour" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Stable releases update in place; nightlies are the rolling build"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- the value lives in the right-hand
                                              column as a quiet state pill — the
                                              "Up to date" pill's twin. It used
                                              to sit in column 0, on top of the
                                              icon tile. -->
                                        <Border Grid.Column="2" Background="{DynamicResource B.SCHigh}" CornerRadius="9"
                                                Padding="10,5" VerticalAlignment="Center"
                                                ToolTip="Stables ship per release; nightlies roll from every main-branch commit">
                                            <TextBlock x:Name="FlavourValue" Text="Nightly" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- BEHAVIOR group: three real switches -->
                                <TextBlock Text="BEHAVIOR" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>

                                <Border x:Name="AutoCheckRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="AutoCheckRow_Click"
                                        ToolTip="Toggles the automatic update check">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Schedule" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Automatic update check" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Once per session, at most every 6 hours — a find lights this tab up, never a popup"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AutoCheckSwitch" Grid.Column="2" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="BetaCheckRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="BetaCheckRow_Click"
                                        ToolTip="Toggles nightly / prerelease checks">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="AutoAwesome" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Include nightlies" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Also check the rolling nightly builds — a nightly hit opens its release page instead of installing"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="BetaCheckSwitch" Grid.Column="2" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="NotifyRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,20"
                                        MouseLeftButtonUp="NotifyRow_Click"
                                        ToolTip="Toggles the update toast">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Bell" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Notify when an update is found" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="The toast pill in the corner — the dot on this tab shows either way"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="NotifySwitch" Grid.Column="2" Style="{StaticResource Md3Switch}"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- MAINTENANCE group -->
                                <TextBlock Text="MAINTENANCE" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>

                                <Border x:Name="ClearDownloadsRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,20"
                                        MouseLeftButtonUp="ClearDownloadsRow_Click"
                                        ToolTip="Deletes the updater's staged download">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Trash" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Clear downloaded updates" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock x:Name="ClearDownloadsCaption" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       Text="No staged update on disk"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="Info" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- HISTORY group -->
                                <TextBlock Text="HISTORY" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>

                                <Border x:Name="ChangelogRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="ChangelogRow_Click"
                                        ToolTip="Every release's notes, straight from GitHub">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="History" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Changelog" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="View version history — pick any release from the pill strip"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="ArrowDrop" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                            <controls:IconGlyph.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </controls:IconGlyph.RenderTransform>
                                        </controls:IconGlyph>
                                    </Grid>
                                </Border>
                                <Border x:Name="CommitsRow" Style="{StaticResource SettingsRowClickable}" Margin="0"
                                        MouseLeftButtonUp="CommitsRow_Click"
                                        ToolTip="Opens the main branch's commit history on GitHub">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Logo" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Commits" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Browse recent changes on the main branch"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource Caption}" Opacity="0.85" TextWrapping="Wrap"
                                           Text="Checks hit GitHub's releases page only — nothing else leaves this machine. The updater downloads the new exe, verifies it against the release's SHA-256 and swaps it in place."/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== Changelog (drill-in) ====================
                     the vivi-music changelog viewer: a horizontal strip of
                     version pills over the selected release's notes —
                     heading, date, hero image and the same bullet rows the
                     feed renders everywhere. Fed by the release list fetch,
                     parsed with the workflow's own Stablemd rules. -->
                <Grid x:Name="ChangelogPane" Visibility="Collapsed">
                    <Grid MaxWidth="760" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
                            <Border x:Name="ChangelogBackButton" Width="34" Height="34" CornerRadius="10"
                                    Background="{DynamicResource B.SCHigh}" VerticalAlignment="Center" Cursor="Hand"
                                    MouseLeftButtonUp="ChangelogBack_Click" ToolTip="Back to Updates">
                                <controls:IconGlyph IconName="ChevLeft" Width="17" Height="17"
                                                    Foreground="{DynamicResource B.Primary}"/>
                            </Border>
                            <TextBlock Text="Changelog" Style="{StaticResource SectionTitle}" FontSize="17"
                                       Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- the version pill strip -->
                        <Border Grid.Row="1" Background="{DynamicResource B.SC}" CornerRadius="14" Padding="10,8"
                                Margin="0,0,0,14">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="VersionPills" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ReleaseTitle" Text="No release selected"
                                                   Style="{StaticResource SectionTitle}" FontSize="17"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ReleaseDate" Style="{StaticResource Caption}" Grid.Column="1"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border x:Name="ReleaseHero" CornerRadius="14" Margin="0,0,0,14"
                                            Visibility="Collapsed" HorizontalAlignment="Left">
                                        <Image x:Name="ReleaseHeroImage" MaxWidth="620" MaxHeight="240" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock x:Name="ReleaseIntro" Style="{StaticResource BodySecondary}"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="ReleaseSections"/>
                                    <TextBlock x:Name="ReleaseLink" Text="Full release notes on GitHub"
                                               Style="{StaticResource M3Link}" Margin="0,12,0,0"
                                               HorizontalAlignment="Left" Visibility="Collapsed"
                                               MouseLeftButtonUp="ReleaseLink_Click"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ==================== About ====================
                     links and details only — the update machinery lives on
                     the Updates tab now -->
                <Grid x:Name="AboutView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardElevated}" MaxWidth="760" VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource B.SCHigh}"
                                            VerticalAlignment="Center">
                                        <controls:IconGlyph IconName="Info" Width="22" Height="22"
                                                            Foreground="{DynamicResource B.Primary}"/>
                                    </Border>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" FontSize="17"
                                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- identity row — clicking the version copies
                                     it (suggestion 19); the Copied chip fades
                                     in where the checkmark text used to sit -->
                                <Border x:Name="VersionRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,16"
                                        MouseLeftButtonUp="VersionRow_Click"
                                        ToolTip="Click to copy the version number">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14" Background="{DynamicResource B.Surface}"
                                                BorderBrush="{DynamicResource B.OutlineVariant}" BorderThickness="1">
                                            <Image Source="pack://application:,,,/Assets/app-36.png" Width="36" Height="36"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="FFX Compatibility Tool" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14"/>
                                                <Border x:Name="VersionChannel" CornerRadius="6" Padding="6,2"
                                                        Background="{DynamicResource B.PrimaryContainer}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="VersionChannelText" Text="STABLE" FontSize="9.5"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource B.OnPrimaryContainer}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Made by marbou92" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border x:Name="AboutCopyChip" Grid.Column="2" Background="{DynamicResource B.Primary}"
                                                CornerRadius="9" Padding="10,5" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:IconGlyph IconName="Check" Width="12" Height="12"
                                                                    Foreground="{DynamicResource B.OnPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Copied" FontSize="11.5" Foreground="{DynamicResource B.OnPrimary}"
                                                           FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- one lead line + the specs chips: the old
                                     three-paragraph wall, made scannable -->
                                <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Downgrades After Effects presets (.ffx) for cross-version compatibility — keyframe data and expression integrity stay intact across software generations."/>
                                <WrapPanel x:Name="SpecsRow" Margin="0,0,0,20">
                                    <Border Background="{DynamicResource B.SCHighest}" BorderBrush="{DynamicResource B.OutlineVariant}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="Windows 10+" Style="{StaticResource Caption}"/>
                                    </Border>
                                    <Border Background="{DynamicResource B.SCHighest}" BorderBrush="{DynamicResource B.OutlineVariant}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text=".NET Framework 4.8" Style="{StaticResource Caption}"/>
                                    </Border>
                                    <Border Background="{DynamicResource B.SCHighest}" BorderBrush="{DynamicResource B.OutlineVariant}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="Single exe" Style="{StaticResource Caption}"/>
                                    </Border>
                                    <Border Background="{DynamicResource B.SCHighest}" BorderBrush="{DynamicResource B.OutlineVariant}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,8,8">
                                        <TextBlock Text="No installer" Style="{StaticResource Caption}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- PROJECT group -->
                                <TextBlock Text="PROJECT" Style="{StaticResource GroupHeader}" Margin="0,0,0,10"/>
                                <Border x:Name="ShaRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="ShaRow_Click"
                                        ToolTip="Computes and copies this exe's SHA-256">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Verified" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Copy SHA-256 of this exe" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="The hash the release page publishes — verify your install against it"
                                                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="Copy" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="RepoRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,10"
                                        MouseLeftButtonUp="RepoRow_Click"
                                        ToolTip="Opens github.com in your browser">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Logo" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="GitHub repository" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Source, releases and the rolling nightly" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="IssueRow" Style="{StaticResource SettingsRowClickable}" Margin="0,0,0,20"
                                        MouseLeftButtonUp="IssueRow_Click"
                                        ToolTip="Opens GitHub in your browser">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                Background="{DynamicResource B.SCHighest}" VerticalAlignment="Center">
                                            <controls:IconGlyph IconName="Warning" Width="17" Height="17"
                                                                Foreground="{DynamicResource B.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Report an issue" Style="{StaticResource Body}" FontWeight="Medium"/>
                                            <TextBlock Text="Bugs and misbehaving presets — verbose logs welcome" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <controls:IconGlyph Grid.Column="2" IconName="OpenInNew" Width="15" Height="15"
                                                            Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource Caption}" Opacity="0.85" TextWrapping="Wrap"
                                           Text="The update status, the switches and the changelog live on the Updates tab."/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
