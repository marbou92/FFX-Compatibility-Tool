<UserControl x:Class="FfxTool.Gui.ConvertPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui"
             AllowDrop="True" DragEnter="Page_DragEnter" Drop="Page_Drop">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Convert Preset" Style="{StaticResource TitlePage}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: workspace ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- hero drop zone (swaps to the effect checklist) -->
                <Grid Grid.Row="0" Margin="0,0,0,16" AllowDrop="True" DragEnter="Page_DragEnter" Drop="Page_Drop">
                    <Border x:Name="Hero" CornerRadius="24" Background="{DynamicResource B.SCLow}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:IconGlyph IconName="FolderOpen" Width="46" Height="46"
                                                Foreground="{DynamicResource B.OnSurfaceVariant}"
                                                HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="No preset loaded" Style="{StaticResource SectionTitle}"
                                       FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Select an Adobe After Effects .ffx file to begin the analysis and conversion process."
                                       Style="{StaticResource BodySecondary}" TextAlignment="Center"
                                       MaxWidth="380" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Button Content="Browse Files" Style="{StaticResource OutlinedButton}"
                                    Width="160" Click="Open_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Rectangle x:Name="HeroDash" RadiusX="24" RadiusY="24" Fill="Transparent"
                               Stroke="{DynamicResource B.OutlineVariant}" StrokeThickness="1.5"
                               StrokeDashArray="4 3" IsHitTestVisible="False"/>
                    <ListBox x:Name="EffectList" Visibility="Collapsed" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Md3CheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MatchName}" Style="{StaticResource Body}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding VendorLabel}" Style="{StaticResource Caption}" Margin="10,1,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- file row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Open .ffx file…" Click="Open_Click" Width="170" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource Chip}" x:Name="StatusChip">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Info" Width="16" Height="16"
                                                Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Status: No file loaded" Style="{StaticResource BodySecondary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- options -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Target version" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TargetCombo" Width="210" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Options" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="OverwriteCheck" Style="{StaticResource Md3CheckBox}" Content="Overwrite File"/>
                    </StackPanel>
                </Grid>

                <!-- full-width expressive CTA -->
                <Button x:Name="ConvertBtn" Grid.Row="3" Content="Convert…" Height="48"
                        IsEnabled="False" Click="Convert_Click"/>
            </Grid>

            <!-- splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ================= RIGHT: insight + console ================= -->
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource P.Primary}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource P.TertiaryContainer}" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="Intelligent Conversion" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                                   Text="Automatically detects missing or incompatible plugins against your profile and suggests removal. Presets are re-encoded to the selected target version."/>
                    </StackPanel>
                </Border>
                <controls:M3Console x:Name="Console"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
