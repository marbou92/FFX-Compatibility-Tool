<UserControl x:Class="FfxTool.Gui.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,24,24">
        <StackPanel>
            <TextBlock Text="Plugin Profiles" Style="{StaticResource TitlePage}" Margin="0,0,0,8"/>
            <TextBlock Text="Check off every plugin vendor you have installed in your target After Effects version. This ensures converted FFX files only reference available effects."
                       Style="{StaticResource BodySecondary}" MaxWidth="720" TextWrapping="Wrap"
                       TextAlignment="Left" HorizontalAlignment="Left" Margin="0,0,0,24"/>

            <!-- bento grid: vendor cards + add-custom + discovery (built in code) -->
            <WrapPanel x:Name="Cards" Margin="0,0,16,16"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
